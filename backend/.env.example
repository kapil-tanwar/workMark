PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string (required in production)
MONGODB_URI=mongodb://127.0.0.1:27017/attend_easy

# Required — use a long random string in production
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated allowed frontend origins (required in production)
# Local:
CORS_ORIGIN=http://localhost:8080
# Production example (set after Vercel deploy):
CORS_ORIGIN=https://work-mark-nu.vercel.app
# Include preview deployments too (comma-separated, no trailing slashes):
# CORS_ORIGIN=https://work-mark-nu.vercel.app,https://work-mark-git-main-yourteam.vercel.app
